# macOS
.DS_Store
._*

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 环境变量
.env
.env.local
.env.*.local

# 依赖
node_modules/
vendor/
.venv/
venv/

# 构建产物
dist/
build/
out/
*.log

# 例外：步骤 0 冒烟的训练 stdout 属于回传证据
!logdir/smoke/*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 训练产物（日志 / checkpoint / 录像）
# 例外：logdir/smoke/ 是步骤 0 的冒烟证据，入库回传；
# latest.pt（219MB，超 GitHub 单文件 100MB 上限）由下面的 *.pt 规则继续忽略。
logdir/*
!logdir/smoke/
logdirs/
runs/
checkpoints/
*.pt
*.pth
*.ckpt
wandb/

# 论文 / 参考资料 / 笔记（本地留存，不入库）
assets/*.pdf
assets/**/*.pdf
assets/*.md
