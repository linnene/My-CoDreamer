# macOS
.DS_Store
._*

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 环境变量
.env
.env.local
.env.*.local

# 依赖
node_modules/
vendor/
.venv/
venv/

# 构建产物
dist/
build/
out/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 训练产物（日志 / checkpoint / 录像）
#
# 证据回传策略：只有小体积**文本**证据入库；二进制（tfevents / npz / 录像 / 权重）
# 一律不入库 —— 它们可重新生成，且会让仓库体积单调增长。
# 白名单是显式的：要新增一种文本证据，必须在这里显式开口子。
# 详见 docs/reproduction-plan.md。
logdir/*
!logdir/smoke/
logdir/smoke/*
!logdir/smoke/*.log
!logdir/smoke/*.jsonl
logdirs/
runs/
checkpoints/
*.pt
*.pth
*.ckpt
wandb/

# 论文 / 参考资料 / 笔记（本地留存，不入库）
assets/*.pdf
assets/**/*.pdf
assets/*.md
